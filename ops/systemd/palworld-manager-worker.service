[Unit]
Description=Palworld Manager worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=palmanager
Group=palmanager
SupplementaryGroups=palworld-manager systemd-journal
WorkingDirectory=/opt/palworld-manager
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/palworld-manager/manager.env
EnvironmentFile=/etc/palworld-manager/secrets.env
ExecStart=/opt/palworld-manager/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0027
StateDirectory=palworld-manager
StateDirectoryMode=0750
StandardOutput=journal
StandardError=journal
SyslogIdentifier=palworld-manager-worker
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/palworld-manager
ReadWritePaths=/home/steam/palserver
ReadWritePaths=/run/palworld-manager/host-control
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# SteamCMD bootstraps through a 32-bit executable and its runtime requires
# executable writable mappings. Keep this exception isolated to the worker.
MemoryDenyWriteExecute=false
SystemCallArchitectures=native x86

[Install]
WantedBy=multi-user.target
