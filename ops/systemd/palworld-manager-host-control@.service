[Unit]
Description=Palworld Manager privileged host control (%i)
ConditionPathExists=/run/palworld-manager/host-control/%i.request

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/palworld-manager-host-control %i
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=palworld-manager-host-control
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/palworld-manager/host-control
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
